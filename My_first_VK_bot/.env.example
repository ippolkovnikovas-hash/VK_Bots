# .env.example
# ========== ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ ==========

# Токен сообщества VK (получить в настройках сообщества)
BOT_TOKEN=your_vk_bot_token_here

# ========== ОПЦИОНАЛЬНЫЕ НАСТРОЙКИ ==========

# Путь к базе данных (по умолчанию database/database.db)
DB_PATH=database/database.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Максимальное количество задач на пользователя
MAX_TASKS_PER_USER=100

# Приоритет по умолчанию (1 - высокий, 2 - средний, 3 - низкий)
DEFAULT_PRIORITY=2

# Включить уведомления (true/false)
ENABLE_NOTIFICATIONS=true

# Интервал проверки напоминаний в секундах (минимум 60)
REMINDER_CHECK_INTERVAL=3600

# Количество задач на странице при просмотре
TASKS_PER_PAGE=10